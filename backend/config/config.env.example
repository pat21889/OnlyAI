PORT=5000
NODE_ENV=development
# MongoDB Atlas > Connect > Drivers. Replace <user>, <password>, and add a db name before "?"
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sportfacility?retryWrites=true&w=majority
# generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=change-me
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30
FRONTEND_URL=http://localhost:3000
